# Shell scripts run in bash on every CI runner, Windows included: keep LF line endings there.
*.sh text eol=lf

# Email test messages are byte-exact (line endings included): never converted on checkout.
tests/RaiCore.Pdf.Tests/Fixtures/Email/** -text

# CSV fuzzing seeds are byte-exact too (line endings, UTF-16).
tests/RaiCore.Pdf.Tests/Fixtures/Fuzz/Seeds/csv/** -text

# Outlook message fixtures and their .eml twins are byte-exact.
tests/RaiCore.Pdf.Tests/Fixtures/Msg/** -text

# Workbooks are ZIP packages: binary, never converted.
tests/RaiCore.Pdf.Tests/Fixtures/Sheets/*.xlsx -text
tests/RaiCore.Pdf.Tests/Fixtures/Fuzz/Seeds/xlsx/** -text

# Presentations are ZIP packages too.
