<Project>

  <!-- Settings shared by every project in the repository. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Our own code may use the APIs marked [Experimental] (docs/experimental.md); users of the packages opt in. -->
    <NoWarn>$(NoWarn);RCPDF001;RCPDF002</NoWarn>
  </PropertyGroup>

  <!-- Package metadata. -->
  <PropertyGroup>
    <Authors>Mikkel Raicevic-Larsen</Authors>
    <Copyright>Copyright © 2026 Mikkel Raicevic-Larsen</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/raicevic/raicore-pdf</PackageProjectUrl>
    <RepositoryUrl>https://github.com/raicevic/raicore-pdf</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>pdf;html-to-pdf;razor;document;conversion</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>https://github.com/raicevic/raicore-pdf/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <!--
      Release trains (#62): the core packages (RaiCore.Pdf, .Fonts, .Layout, .Html and .Razor) share one version, are
      released together by a tag v<version> and depend on each other at exactly that version, since they use each
      other's internals. A package with its own version (a new format, which may start at 0.x) sets
      <IsCorePackage>false</IsCorePackage> and its own <VersionPrefix> in its project file, is released alone by a tag
      <PackageId>/v<version>, may use only the core's public API, and depends on the core from CoreVersionPrefix up to
      the next major version. See "Releasing" in CONTRIBUTING.md.
      CoreVersionPrefix is the core's latest (or upcoming) release; the release workflow checks tags against it.
    -->
    <CoreVersionPrefix>1.1.0</CoreVersionPrefix>
    <IsCorePackage>true</IsCorePackage>
    <VersionPrefix>$(CoreVersionPrefix)</VersionPrefix>
    <!--
      Local and CI builds are "-dev". A release build passes ReleaseTrain (core, or the PackageId it releases) and
      ReleaseSuffix (the tag's prerelease part, often empty): the packages of that train get ReleaseSuffix, all others
      none, so a package with its own version depends on a released core version.
    -->
    <VersionSuffix>dev</VersionSuffix>
    <VersionSuffix Condition="'$(ReleaseTrain)' != ''"></VersionSuffix>
    <VersionSuffix Condition="'$(ReleaseTrain)' == 'core' or '$(ReleaseTrain)' == '$(MSBuildProjectName)'">$(ReleaseSuffix)</VersionSuffix>
  </PropertyGroup>

  <!-- Debugging into the packages: symbol packages (.snupkg) and SourceLink to the exact GitHub commit. -->
  <PropertyGroup>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- Library projects (under src/): stricter analysis, XML docs, AOT/trim safety. -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('$([System.IO.Path]::DirectorySeparatorChar)src$([System.IO.Path]::DirectorySeparatorChar)'))">
    <IsPackable>true</IsPackable>
    <AnalysisMode>Recommended</AnalysisMode>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <EnablePackageValidation>true</EnablePackageValidation>
    <!-- Packing compares each package with the last released version and fails on a breaking change (#61). Keep it at
         the latest release. -->
    <PackageValidationBaselineVersion>1.1.0</PackageValidationBaselineVersion>
  </PropertyGroup>

  <!--
    The public API of each package is listed in PublicAPI.Shipped.txt (what the last release has)
    and PublicAPI.Unshipped.txt (changed since). Changing the API without updating them fails the build (RS0016/RS0017),
    so every change to it shows up in review. See "Public API" in CONTRIBUTING.md.
  -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <!-- The package adds the project's PublicAPI.*.txt files as AdditionalFiles itself. -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <!-- Each package has its own README (shown on nuget.org); links in it must be absolute. -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildProjectDirectory)/README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <PropertyGroup Condition="!$(MSBuildProjectDirectory.Contains('$([System.IO.Path]::DirectorySeparatorChar)src$([System.IO.Path]::DirectorySeparatorChar)'))">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
