{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [
            "*/*.csproj"
          ]
        }
      ],
      "dest": "api",
      "properties": {
        "Configuration": "Release"
      },
      "namespaceLayout": "flattened"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**",
          "obj/**",
          "snippets/**",
          "api-review.md"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "RaiCore.Pdf",
      "_appTitle": "RaiCore.Pdf",
      "_enableSearch": true,
      "_gitContribute": {
        "repo": "https://github.com/raicevic/raicore-pdf",
        "branch": "main"
      }
    },
    "markdownEngineProperties": {
      "alerts": {}
    }
  }
}
