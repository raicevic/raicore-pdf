@* A whole HTML document as a Razor component. At-rules are written with a double @ in .razor files. *@
<!DOCTYPE html>
<html lang="en">
<head>
  <title>Invoice @Invoice.Number</title>
  <style>
    @@page { size: A4; margin: 20mm; @@bottom-right { content: counter(page) " / " counter(pages); font-size: 8pt; } }
    html { font-family: Arial, sans-serif; }
    td.amount { text-align: right; }
  </style>
</head>
<body>
  <h1>Invoice @Invoice.Number</h1>
  <table>
    @foreach (var line in Invoice.Lines)
    {
      <tr><td>@line.Description</td><td class="amount">@line.Amount.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</td></tr>
    }
  </table>
</body>
</html>

@code {
    [Parameter, EditorRequired]
    public Invoice Invoice { get; set; } = default!;
}
