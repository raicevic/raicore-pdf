<Project Sdk="Microsoft.NET.Sdk">

  <!-- The sample app that docs/docker/Dockerfile builds. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- The newest version in ./packages (see nuget.config); name a fixed version once 1.0 is on NuGet. -->
    <PackageReference Include="RaiCore.Pdf.Html" Version="*-*" />
  </ItemGroup>

</Project>
