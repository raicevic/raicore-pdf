<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Until 1.0 is on NuGet, the RaiCore packages come from ./packages: run `dotnet pack -c Release -o docs/docker/packages`
    in the repository first. Delete this file once you use the published packages.
  -->
  <packageSources>
    <clear />
    <add key="local" value="packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="RaiCore.Pdf" />
      <package pattern="RaiCore.Pdf.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
