<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Create PDF documents from .NET: object model, writer, fonts and drawing API.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RaiCore.Pdf.Tests" />
    <InternalsVisibleTo Include="RaiCore.Pdf.Fuzz" />
    <!-- Sibling packages need the raw font data and glyph-level access. -->
    <InternalsVisibleTo Include="RaiCore.Pdf.Layout" />
    <!-- Resource limits: the HTML converter enforces them and checks the time limit while it builds boxes. -->
    <InternalsVisibleTo Include="RaiCore.Pdf.Html" />
    <!-- Text and image extraction reads pages with the reader's parser, stream decoders and font tables. -->
    <InternalsVisibleTo Include="RaiCore.Pdf.Extraction" />
    <!-- Editing copies and writes existing files with the reader's object store and the file writer. -->
    <InternalsVisibleTo Include="RaiCore.Pdf.Editing" />
    <!-- Compound File Binary (OLE2) reader: Outlook .msg, Word .doc, Excel .xls and PowerPoint .ppt files. -->
    <InternalsVisibleTo Include="RaiCore.Pdf.Email" />
    <InternalsVisibleTo Include="RaiCore.Pdf.Documents" />
    <InternalsVisibleTo Include="RaiCore.Pdf.Sheets" />
    <InternalsVisibleTo Include="RaiCore.Pdf.Slides" />
    <!-- Dynamic XFA forms: the XFA packets are read from the PDF file with the reader. -->
    <InternalsVisibleTo Include="RaiCore.Pdf.Xfa" />
  </ItemGroup>

  <ItemGroup>
    <!-- The sRGB profile of the PDF/A output intent (CC0, Compact-ICC-Profiles). -->
    <EmbeddedResource Include="ColorProfiles\sRGB-v2-micro.icc" LogicalName="RaiCore.Pdf.ColorProfiles.sRGB-v2-micro.icc" />
  </ItemGroup>

</Project>
