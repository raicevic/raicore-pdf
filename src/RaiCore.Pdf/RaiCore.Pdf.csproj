<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Create PDF documents from .NET: object model, writer, fonts and drawing API.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RaiCore.Pdf.Tests" />
    <InternalsVisibleTo Include="RaiCore.Pdf.Fuzz" />
    <!-- Sibling packages need the raw font data and glyph-level access. -->
    <InternalsVisibleTo Include="RaiCore.Pdf.Layout" />
    <!-- Resource limits: the HTML converter enforces them and checks the time limit while it builds boxes. -->
    <InternalsVisibleTo Include="RaiCore.Pdf.Html" />
  </ItemGroup>

  <ItemGroup>
    <!-- The sRGB profile of the PDF/A output intent (CC0, Compact-ICC-Profiles). -->
    <EmbeddedResource Include="ColorProfiles\sRGB-v2-micro.icc" LogicalName="RaiCore.Pdf.ColorProfiles.sRGB-v2-micro.icc" />
  </ItemGroup>

</Project>
