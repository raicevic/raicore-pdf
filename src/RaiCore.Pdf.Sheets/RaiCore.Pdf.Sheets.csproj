<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Convert spreadsheets to PDF with RaiCore.Pdf: CSV files and Excel workbooks (.xlsx, and Excel 97-2003 .xls) as paginated tables with repeated header rows, number formats, styles, merged cells and print areas, column widths fitted to the content and the page.</Description>
    <PackageTags>$(PackageTags);csv;tsv;csv-to-pdf;xlsx;xls;excel;xlsx-to-pdf;xls-to-pdf;excel-to-pdf;spreadsheet;table</PackageTags>
    <!--
      A core package, released with the core at the same version. It uses only the public API of RaiCore.Pdf.Layout
      and RaiCore.Pdf.Fonts.
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RaiCore.Pdf.Layout\RaiCore.Pdf.Layout.csproj" />
    <ProjectReference Include="..\RaiCore.Pdf.Fonts\RaiCore.Pdf.Fonts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RaiCore.Pdf.Tests" />
  </ItemGroup>

</Project>
