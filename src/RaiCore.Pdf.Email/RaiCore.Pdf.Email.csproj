<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Convert email messages (.eml) and web archives (.mht) to PDF with RaiCore.Pdf: the message with a header block, inline images in place and its attachments embedded, listed or appended.</Description>
    <PackageTags>$(PackageTags);eml;mht;mhtml;email-to-pdf;mime</PackageTags>
    <!--
      A core package, released with the core at the same version. It uses only the public API of RaiCore.Pdf.Html. It
      has no released version to validate against yet: set the baseline to the first release that includes it.
    -->
    <PackageValidationBaselineVersion></PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RaiCore.Pdf.Html\RaiCore.Pdf.Html.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RaiCore.Pdf.Tests" />
  </ItemGroup>

</Project>
