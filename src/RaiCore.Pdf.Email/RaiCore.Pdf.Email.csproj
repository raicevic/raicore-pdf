<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Convert email messages (.eml), Outlook messages (.msg) and web archives (.mht) to PDF with RaiCore.Pdf: the message with a header block, inline images in place and its attachments embedded, listed or appended.</Description>
    <PackageTags>$(PackageTags);eml;msg;outlook;mht;mhtml;email-to-pdf;msg-to-pdf;mime</PackageTags>
    <!--
      A core package, released with the core at the same version. It uses only the public API of RaiCore.Pdf.Html.
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RaiCore.Pdf.Html\RaiCore.Pdf.Html.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RaiCore.Pdf.Tests" />
    <InternalsVisibleTo Include="RaiCore.Pdf.Fuzz" />
  </ItemGroup>

</Project>
