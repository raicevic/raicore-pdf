<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Edit existing PDF files with RaiCore.Pdf: delete, insert, move and rotate pages, and save as often as needed.</Description>
    <PackageTags>$(PackageTags);pdf-editing;pdf-merge</PackageTags>
    <!--
      A core package (it uses the core's PDF reader and writer through InternalsVisibleTo, so it is released with the
      core at the same version).
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RaiCore.Pdf\RaiCore.Pdf.csproj" />
    <ProjectReference Include="..\RaiCore.Pdf.Extraction\RaiCore.Pdf.Extraction.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RaiCore.Pdf.Tests" />
  </ItemGroup>

</Project>
