@* One invoice. In .razor files, CSS at-rules are written with a double @ (@@page). *@
<!DOCTYPE html>
<html lang="en">
<head>
  <title>Invoice @Invoice.Id</title>
  <style>
    @@page { size: A4; margin: 20mm; @@bottom-right { content: "Page " counter(page) " of " counter(pages); font-size: 8pt; } }
    html { font-family: Arial, sans-serif; } /* The margin boxes inherit from the root element. */
    body { font-size: 10pt; }
    h1 { color: #1a4f8b; }
    table { width: 100%; border-collapse: collapse; }
    th, td { padding: 2mm; border-bottom: 0.5pt solid #ccc; text-align: left; }
    .num { text-align: right; }
  </style>
</head>
<body>
  <h1>Invoice @Invoice.Id</h1>
  <p>@Invoice.Customer<br>@Invoice.Date.ToString("d MMMM yyyy", CultureInfo.InvariantCulture)</p>
  <table>
    <thead><tr><th>Description</th><th class="num">Quantity</th><th class="num">Price</th></tr></thead>
    <tbody>
      @foreach (var line in Invoice.Lines)
      {
        <tr><td>@line.Description</td><td class="num">@line.Quantity</td><td class="num">@line.Price.ToString("N2", CultureInfo.InvariantCulture)</td></tr>
      }
    </tbody>
  </table>
  <p class="num"><b>Total: @Invoice.Total.ToString("N2", CultureInfo.InvariantCulture)</b></p>
</body>
</html>

@code {
    [Parameter, EditorRequired]
    public Invoice Invoice { get; set; } = default!;
}
