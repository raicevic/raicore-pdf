<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- A private package cache, so a re-packed version is never served stale from ~/.nuget/packages. -->
    <add key="globalPackagesFolder" value=".packages" />
  </config>
  <packageSources>
    <clear />
    <add key="local" value="../../artifacts" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <!-- RaiCore packages only from the local build output, never from nuget.org. -->
    <packageSource key="local">
      <package pattern="RaiCore.Pdf" />
      <package pattern="RaiCore.Pdf.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
