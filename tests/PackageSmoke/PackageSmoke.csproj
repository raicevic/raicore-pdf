<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Installs the packages from ../../artifacts and runs the README samples. Not part of RaiCore.Pdf.slnx. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <!-- The release workflow passes the exact version; otherwise take the newest package in artifacts/. -->
    <RaiCoreVersion Condition="'$(RaiCoreVersion)' == ''">*-*</RaiCoreVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only the top-level package: the rest must arrive as its dependencies. -->
    <PackageReference Include="RaiCore.Pdf.Razor" Version="$(RaiCoreVersion)" />
  </ItemGroup>

</Project>
