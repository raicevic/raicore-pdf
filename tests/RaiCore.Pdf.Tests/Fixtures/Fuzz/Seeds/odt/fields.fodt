-style style:name="Outline"><text:outline-level-style text:level="1" style:num-format=""/><text:outline-level-style text:level="2" style:num-format=""/></text:outline-style><text:notes-configuration text:note-class="footnote" style:num-format="1" text:citation-style-name="Footnote_20_anchor" text:start-value="0"/><text:notes-configuration text:note-class="endnote" style:num-format="i" text:citation-style-name="Footnote_20_anchor" text:start-value="0"/></office:styles><office:automatic-styles><style:page-layout style:name="pm1"><style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:num-format="1" style:print-orientation="portrait" fo:margin-top="2cm" fo:margin-bottom="2cm" fo:margin-left="2cm" fo:margin-right="2cm"/><style:header-style/><style:footer-style/></style:page-layout><style:style style:name="P1" style:family="paragraph" style:parent-style-name="Standard" ><style:paragraph-properties fo:break-before="page"></style:paragraph-properties></style:style><style:style style:name="Sect1" style:family="section"><style:section-properties><style:columns fo:column-count="2" fo:column-gap="0.5cm"/></style:section-properties></style:style></office:automatic-styles><office:master-styles><style:master-page style:name="Standard" style:page-layout-name="pm1"/></office:master-styles><office:body><office:text><text:tracked-changes><text:changed-region text:id="ct1"><text:deletion><office:change-info><dc:creator>Editor</dc:creator><dc:date>2026-01-01T00:00:00</dc:date></office:change-info><text:p text:style-name="Standard">deleted words</text:p></text:deletion></text:changed-region><text:changed-region text:id="ct2"><text:insertion><office:change-info><dc:creator>Editor</dc:creator><dc:date>2026-01-01T00:00:00</dc:date></office:change-info></text:insertion></text:changed-region></text:tracked-changes><text:sequence-decls><text:sequence-decl text:display-outline-level="0" text:name="Table"/></text:sequence-decls><text:h text:style-name="Heading_20_1" text:outline-level="1">Fields and notes</text:h><text:table-of-content text:name="Contents"><text:table-of-content-source text:outline-level="2"><text:index-title-template>Template title</text:index-title-template></text:table-of-content-source><text:index-body><text:index-title text:name="Contents_Head"><text:p text:style-name="Standard">Contents</text:p></text:index-title><text:p text:style-name="Standard"><text:a xlink:type="simple" xlink:href="#later">Later section<text:tab/>2</text:a></text:p></text:index-body></text:table-of-content><text:p text:style-name="Text_20_body">Title: <text:title>Fixture title</text:title>, author: <text:author-name>Ann Author</text:author-name>, date: <text:date style:data-style-name="N1" text:date-value="2026-01-01">2026-01-01</text:date>, time: <text:time text:time-value="12:00:00">12:00:00</text:time>, chapter: <text:chapter text:display="name" text:outline-level="1">Fields and notes</text:chapter>, sequence: Table <text:sequence text:ref-name="refTable0" text:name="Table" text:formula="ooow:Table+1" style:num-format="1">1</text:sequence>.</text:p><text:p text:style-name="Text_20_body">See page <text:bookmark-ref text:reference-format="page" text:ref-name="later">1</text:bookmark-ref> for the later bookmark.</text:p><text:p text:style-name="Text_20_body">Footnote here<text:note text:id="ftn1" text:note-class="footnote"><text:note-citation>1</text:note-citation><text:note-body><text:p text:style-name="Footnote">The first footnote text.</text:p></text:note-body></text:note> and endnote<text:note text:id="edn1" text:note-class="endnote"><text:note-citation>i</text:note-citation><text:note-body><text:p text:style-name="Footnote">The endnote text.</text:p></text:note-body></text:note> and a custom mark<text:note text:id="ftn2" text:note-class="footnote"><text:note-citation text:label="*">*</text:note-citation><text:note-body><text:p text:style-name="Footnote">Custom mark note.</text:p></text:note-body></text:note>.</text:p><text:p text:style-name="Text_20_body">Inserted <text:change-start text:change-id="ct2"/>new<text:change-end text:change-id="ct2"/> text<text:change text:change-id="ct1"/> stays.</text:p><text:p text:style-name="Text_20_body">Commented<office:annotation><dc:creator>Reviewer</dc:creator><dc:date>2026-01-01T00:00:00</dc:date><text:p text:style-name="Standard">A comment</text:p></office:annotation> text.</text:p><text:section text:name="Visible"><text:p text:style-name="Standard">Visible section text.</text:p></text:section><text:section text:name="Hidden" text:display="none"><text:p text:style-name="Standard">Hidden section text.</text:p></text:section><text:section text:name="Columns" text:style-name="Sect1"><text:p text:style-name="Standard">Two column section text.</text:p></text:section><text:p text:style-name="Standard">Ruby <text:ruby><text:ruby-base>base</text:ruby-base><text:ruby-text>annotation</text:ruby-text></text:ruby> text.</text:p><text:p text:style-name="Standard">Hidden field<text:hidden-text text:condition="ooow:1" text:string-value="hidden by a field" text:is-hidden="true"/> and a <text:placeholder text:placeholder-type="text">placeholder</text:placeholder>.</text:p><text:p text:style-name="Standard">Soft<text:soft-page-break/> page break.</text:p><text:p text:style-name="P1"><text:bookmark text:name="later"/>The later bookmark on page two.</text:p><text:p text:style-name="Standard">Page <text:page-number text:select-page="current">2</text:page-number> of <text:page-count>2</text:page-count> in the body.</text:p></office:text></office:body></office:document>
